APP_ENV=development
APP_DEBUG=true
APP_DEMO_MODE=true
DATABASE_URL=postgresql+psycopg://case_user:case_password@postgres:5432/case_ai
REDIS_URL=redis://redis:6379/0
STORAGE_ROOT=/app/storage

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
OPENROUTER_API_KEY=

DEFAULT_LLM_PROVIDER=fake
DEFAULT_ANALYSIS_MODEL=demo-analysis-v1
DEFAULT_CODE_MODEL=demo-code-v1
DEFAULT_TEST_MODEL=demo-test-v1
ENABLE_PROVIDER_FALLBACK=true
ENABLE_OPENROUTER_FOR_OPENAI=false
ENABLE_OPENROUTER_FOR_ANTHROPIC=false

CORS_ORIGINS=http://localhost:5173,http://localhost:8080
API_RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_SIZE_MB=10
DEPLOYMENT_DRY_RUN_DEFAULT=true
MCP_ENABLE_REMOTE=true
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
MCP_REQUIRE_APPROVAL_FOR_SIDE_EFFECT_TOOLS=true
